# Server-side only — never prefix with VITE_, never expose to the client bundle.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Lead notifications (contact form + KI-Audit) — sent via Resend.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives lead notifications. Defaults to info@swissai-optimize.ch if unset.
LEAD_NOTIFY_EMAIL=

# Verified Resend sender, e.g. "SwissAI Optimize <leads@swissai-optimize.ch>".
# Until a domain is verified in Resend, defaults to the Resend sandbox sender.
RESEND_FROM_EMAIL=

# Weekly "KI-Sichtbarkeits-Pulse" follow-up emails for KI-Audit leads.
# Storage: connect a Redis integration (Vercel dashboard → Storage → Marketplace → Upstash Redis)
# to this project — it auto-injects KV_REST_API_URL/KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL/
# UPSTASH_REDIS_REST_TOKEN). No manual value needed here; without it the feature is silently inactive.

# Protects /api/weekly-pulse from being triggered by anyone who guesses the URL.
# Generate any random string; Vercel Cron automatically sends it as a Bearer token when set.
CRON_SECRET=
